<?xml version="1.0" encoding="utf-8"?>
<!-- Manifest = "wizytówka" aplikacji dla systemu: nazwa, ekrany, uprawnienia. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Wibracja wymaga tego uprawnienia (przyznawane automatycznie przy instalacji, bez pytania).
         Latarka i dźwięk ani dyktowanie (przez systemowe okno rozpoznawania mowy) uprawnień nie wymagają,
         więc dostęp do mikrofonu nie jest potrzebny. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- exported="true": aktywność może uruchomić ktoś spoza aplikacji (tu: ekran główny telefonu). -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- MAIN + LAUNCHER = pokaż ikonę w menu aplikacji i uruchom tę aktywność po jej kliknięciu. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
