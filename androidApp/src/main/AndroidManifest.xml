<?xml version="1.0" encoding="utf-8"?>
<!-- Manifest = "wizytówka" aplikacji dla systemu: nazwa, ekrany, uprawnienia. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Tu dojdą uprawnienia, gdy będą kanały i dyktowanie, np.:
         <uses-permission android:name="android.permission.VIBRATE" />
         <uses-permission android:name="android.permission.RECORD_AUDIO" /> -->

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- exported="true": aktywność może uruchomić ktoś spoza aplikacji (tu: ekran główny telefonu). -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- MAIN + LAUNCHER = pokaż ikonę w menu aplikacji i uruchom tę aktywność po jej kliknięciu. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
